# Wallet-transfer service environment variables.
#
# Copy this file to `.env` and fill in your local values, or export the
# variables directly. Defaults shown after the `#` are what the service
# falls back to when the variable is unset.
#
# Required (no default):
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable

# Server (defaults shown):
PORT=8080                       # default 8080
SHUTDOWN_TIMEOUT=10s            # graceful shutdown deadline; default 10s

# Logging (defaults shown):
LOG_LEVEL=info                  # debug | info | warn | error; default info
LOG_JSON=true                   # true => JSON; false => text; default true

# Postgres connection pool (defaults shown):
DB_MAX_OPEN_CONNS=10            # default 10
DB_MAX_IDLE_CONNS=5             # default 5
DB_CONN_MAX_LIFETIME=30m        # default 30m
DB_PING_TIMEOUT=5s              # default 5s

# Integration tests only — point at a Postgres the test suite is allowed to
# TRUNCATE between cases. Use a separate database from DATABASE_URL so a
# misfired test cannot wipe local-dev data. If unset, the integration suite
# is skipped.
INTEGRATION_DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet_test?sslmode=disable
