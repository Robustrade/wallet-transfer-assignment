# Copy to .env and adjust as needed. .env is gitignored.

# HTTP server
HTTP_ADDR=:8080

# Postgres connection string (pgx / database-sql compatible DSN)
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet_transfer?sslmode=disable

# Connection pool
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# Logging: debug | info | warn | error
LOG_LEVEL=info
