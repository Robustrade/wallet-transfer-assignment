# Copy this file to .env and adjust values as needed: cp .env.example .env

# HTTP port the API listens on
PORT=8000

# Gin mode: debug, release or test (optional, defaults to release)
GIN_MODE=release

# PostgreSQL connection (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=wallet
DB_SSLMODE=disable
