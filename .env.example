# Copy to .env and adjust:  cp .env.example .env
# Used by `go run ./cmd/api`, `make migrate-*`, `make test-integration` and docker compose.

# Application
APP_PORT=8080
APP_ENV=development

# PostgreSQL
# DB_HOST/DB_PORT are used by the host-run API and tests.
# Under `docker compose` the API talks to the `postgres` service automatically
# and PostgreSQL is published on POSTGRES_HOST_PORT (default 5433).
DB_HOST=localhost
DB_PORT=5432
DB_USER=wallet
DB_PASSWORD=change-me
DB_NAME=wallet_db
DB_SSLMODE=disable
# GORM SQL logging: silent | error | warn (default) | info. `info` prints every
# statement with its parameters, so use it only for local debugging.
# DB_LOG_LEVEL=warn

# Docker Compose only (optional)
# API_HOST_PORT=8090
# POSTGRES_HOST_PORT=5433

# Logging
LOG_LEVEL=info
