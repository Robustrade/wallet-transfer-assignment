# Copy to .env and adjust. Every variable is optional; defaults are shown.

PORT=8080

# sqlite (default) or postgres. Any other value fails at startup.
DB_DRIVER=sqlite

# SQLite: a file path DSN. Postgres: required, e.g.
#   postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
DB_DSN=file:wallet.db

# Per-request deadline.
REQUEST_TIMEOUT=5s

# How long a transaction waits for a lock:
# Postgres lock_timeout / SQLite busy_timeout.
LOCK_TIMEOUT=5s

# Requests with larger bodies get 413 PAYLOAD_TOO_LARGE.
MAX_BODY_BYTES=1048576
