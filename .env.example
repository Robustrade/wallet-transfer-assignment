# Copy to .env and adjust as needed. `make` loads this file automatically.

DATABASE_URL=postgres://wallet:wallet@localhost:5440/walletdb?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DB_MAX_CONNS=10
DB_STATEMENT_TIMEOUT=5s
DB_LOCK_TIMEOUT=3s

# Only used by `make test` / `make test-integration`.
POSTGRES_PORT=5440
