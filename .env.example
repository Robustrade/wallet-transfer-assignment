# Copy to .env and replace USER and PASSWORD with your local PostgreSQL credentials.
DATABASE_URL='postgres://USER:PASSWORD@127.0.0.1:5432/wallet?sslmode=disable'
# Use a separate database ending in _test for integration tests.
TEST_DATABASE_URL='postgres://USER:PASSWORD@127.0.0.1:5432/wallet_test?sslmode=disable'

HTTP_HOST=127.0.0.1
HTTP_PORT=8080
DB_OPERATION_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=15s
MAX_TRANSFER_AMOUNT=1000000000000
