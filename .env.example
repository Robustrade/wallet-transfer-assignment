# Copy to .env to override defaults. Every value is optional: docker compose and the
# binary fall back to the defaults shown here.

# --- docker compose ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
DB_HOST_PORT=5433        # host port for Postgres (5433 avoids clashing with a local Postgres)
APP_HOST_PORT=8080       # host port for the API

# --- wallet binary ---
# DATABASE_URL is required when running the binary outside compose
# (compose builds it from the POSTGRES_* values above).
# DATABASE_URL=postgres://wallet:wallet@localhost:5433/wallet?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=INFO           # DEBUG | INFO | WARN | ERROR
DB_MAX_CONNS=20
DB_LOCK_TIMEOUT=3s       # max wait for a wallet row lock before answering 503 (retryable)
DB_CONNECT_WAIT=30s      # how long to wait for the database at startup
SHUTDOWN_TIMEOUT=10s     # graceful shutdown budget for in-flight requests
