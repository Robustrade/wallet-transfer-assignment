# Use the SAME password that works in psql / pgAdmin
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/rapido_db?sslmode=disable

# Or Docker Compose (make up) on host port 5433:
# DATABASE_URL=postgres://wallet:wallet@localhost:5433/wallet_transfer?sslmode=disable

HTTP_PORT=8080
LOG_LEVEL=info
