# Copy this file to `.env` and edit the values for your environment.
# `.env` is gitignored — secrets put there will NOT be committed.
#
# docker-compose.yml reads these via ${VAR:-default} substitution; if you
# leave a value unset (or skip the .env file entirely), the literal
# defaults baked into docker-compose.yml apply, which are safe-but-static
# values intended for local development only.

# Postgres database name
DB_NAME=wallet_db

# Postgres username
DB_USER=wallet_user

# Postgres password — REPLACE for any non-trivial environment.
# Local dev only; never reuse this value in CI/staging/prod.
DB_PASS=wallet_pass
