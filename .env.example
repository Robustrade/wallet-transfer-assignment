# Copy this file to .env (gitignored) and fill in real values.
#
# Neon: Dashboard -> your project -> "Connection string" (Pooled connection).
# Keep sslmode=require — Neon requires TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# HTTP server port (optional; the server defaults to 8080 if unset).
PORT=8080
