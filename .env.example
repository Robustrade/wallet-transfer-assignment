DATABASE_URL=postgres://wallet:wallet@localhost:5433/wallet?sslmode=disable
HTTP_ADDR=:8080
# Separate DB so test TRUNCATE does not wipe manual/API data in `wallet`.
TEST_DATABASE_URL=postgres://wallet:wallet@localhost:5433/wallet_test?sslmode=disable
MIGRATIONS_DIR=migrations

# pgx pool (explicit production defaults)
DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=2

# HTTP server timeouts
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=65s
HTTP_IDLE_TIMEOUT=60s
# Cancels request context (pool acquire + DB work) after this duration
HTTP_REQUEST_TIMEOUT=60s
