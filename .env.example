# Example environment configuration for the wallet transfer service.
# Copy to `.env` and adjust as needed:  cp .env.example .env
# All values have sensible defaults; everything here is optional.

# HTTP listen address.
HTTP_ADDR=:8080

# PostgreSQL DSN. Leave empty to use the in-memory store (local/demo only).
# Example for the docker-compose stack:
# DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
DATABASE_URL=

# Maximum number of pooled database connections.
DB_MAX_CONNS=10
