<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <!-- Bump to DEBUG when Testcontainers cannot find a Docker environment. -->
  <logger name="org.testcontainers" level="INFO"/>
  <logger name="com.robustrade.wallet" level="DEBUG"/>
  <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
