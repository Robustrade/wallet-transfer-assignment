    {
      "name": "End-to-End Flow",
      "description": "Run steps in order. Step 2 saves the idempotency key for Step 5 automatically.",
      "item": [
        {
          "name": "Step 1 - Check wallet_1 Balance (Before)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('e2eBalanceBefore', pm.response.json().data.balance);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"walletId\": \"wallet_1\"\n}" },
            "url": "{{baseUrl}}/v1/wallet-balance"
          }
        },
        {
          "name": "Step 2 - Transfer 200 wallet_1 → wallet_2",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('e2eIdempotencyKey', 'postman-e2e-' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('transfer PROCESSED', () => pm.expect(pm.response.json().data.status).to.eql('PROCESSED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"{{e2eIdempotencyKey}}\",\n  \"fromWalletId\": \"wallet_1\",\n  \"toWalletId\": \"wallet_2\",\n  \"amount\": 200\n}"
            },
            "url": "{{baseUrl}}/v1/transfers"
          }
        },
        {
          "name": "Step 3 - Check wallet_1 Balance (After)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const before = pm.collectionVariables.get('e2eBalanceBefore');",
                  "const after = pm.response.json().data.balance;",
                  "pm.test('balance reduced by 200', () => pm.expect(after).to.eql(before - 200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"walletId\": \"wallet_1\"\n}" },
            "url": "{{baseUrl}}/v1/wallet-balance"
          }
        },
        {
          "name": "Step 4 - View wallet_1 Transfer History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('history not empty', () => pm.expect(pm.response.json().data.length).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"walletId\": \"wallet_1\"\n}" },
            "url": "{{baseUrl}}/v1/transfer-history"
          }
        },
        {
          "name": "Step 5 - Replay Transfer (Idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('replay succeeds', () => pm.expect(pm.response.json().responseCode).to.eql(20001));",
                  "const afterReplay = pm.response.json().data;",
                  "pm.test('still PROCESSED', () => pm.expect(afterReplay.status).to.eql('PROCESSED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"{{e2eIdempotencyKey}}\",\n  \"fromWalletId\": \"wallet_1\",\n  \"toWalletId\": \"wallet_2\",\n  \"amount\": 200\n}"
            },
            "url": "{{baseUrl}}/v1/transfers",
            "description": "Uses e2eIdempotencyKey set in Step 2. Re-run Step 3 after this — balance must not change."
          }
        },
        {
          "name": "Step 6 - Confirm Balance Unchanged After Replay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const before = pm.collectionVariables.get('e2eBalanceBefore');",
                  "const current = pm.response.json().data.balance;",
                  "pm.test('balance still reduced by exactly 200 from original', () => pm.expect(current).to.eql(before - 200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"walletId\": \"wallet_1\"\n}" },
            "url": "{{baseUrl}}/v1/wallet-balance"
          }
        }
      ]
    }
  ]
}
