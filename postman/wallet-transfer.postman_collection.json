    {
      "name": "6. Cleanup",
      "item": [
        {
          "name": "Move the 100 back (wallet_2 → wallet_1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('PROCESSED', () => pm.expect(pm.response.json().status).to.eql('PROCESSED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"postman-{{runId}}-cleanup\",\n  \"fromWalletId\": \"wallet_2\",\n  \"toWalletId\": \"wallet_1\",\n  \"amount\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] },
            "description": "Keeps a full collection run balance-neutral."
          }
        }
      ]
    }
