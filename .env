# Runtime configuration for local development.
#
# This file is committed on purpose: it holds only local, throwaway values
# (the Postgres credentials match docker-compose.yml). Put real secrets in
# .env.local (gitignored) or the process environment, which both override this.

# HTTP listen address
HTTP_ADDR=:8080

# PostgreSQL DSN (pgx-compatible)
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet_transfer?sslmode=disable

# Connection pool / connect timeout
DB_MAX_OPEN_CONNS=10
DB_CONNECT_TIMEOUT_SECONDS=5

# Apply embedded migrations on startup
DB_AUTO_MIGRATE=true

# Logging: debug | info | warn | error
LOG_LEVEL=info
